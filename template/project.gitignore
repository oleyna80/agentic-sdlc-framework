# Agentic SDLC Framework - generated project ignore file
#
# bootstrap.sh copies this file to .gitignore in new projects.
# Keep this filename inactive inside the framework repository so the
# publishable template files are not hidden by nested gitignore rules.

# Portable governance/runtime contracts are committed by default. Explicit
# negations protect them from user/global blanket excludes such as `.agent/` or
# `.codex/`; narrower local-state rules below still win because they appear later.
!.agent/
!.agent/**
!.codex/
!.codex/**
!.claude/
!.claude/**
!.opencode/
!.opencode/**
!CLAUDE.md
!opencode.json
!.mcp.json

# Ignore only operational, private, generated, or user-local state.
.agent/active-work-block.json
.agent/critic-gate.md
.agent/verification-gate.md
.agent/project-config.md

memory_bank/
.claude/agent-memory/
.claude/backups/
.claude/plans/
.claude/plugins/
.claude/shell-snapshots/
.claude/.last-cleanup

# User-local Codex activation and cache/state.
.codex/config.toml
.codex/cache/
.codex/logs/
.codex/runtime/
.codexignore
.agentsignore

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
.next/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local tool artifacts
.playwright-cli/
